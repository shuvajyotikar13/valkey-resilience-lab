VALKEY_IMAGE=valkey/valkey:9.1.2
NODE_MEMORY_LIMIT=768m
VALKEY_MAXMEMORY=512mb
VALKEY_MAXMEMORY_POLICY=allkeys-lru
REPL_BACKLOG_SIZE=64mb
APPENDONLY=no
CLUSTER_NODE_TIMEOUT_MS=3000

# Workload defaults. Tune TARGET_RPS only after running the envelope test.
TARGET_RPS=30000
WORKERS=32
PRELOAD_KEYS=250000
KEYSPACE=250000
VALUE_SIZES=256:70,1024:25,4096:5
